---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { signupHref } from '../config';
import { t, defaultLocale, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const copy = t(locale).pricing;
---

<section class="px-6 pb-24" aria-label="Plans and prices">
  <ul
    class="mx-auto grid max-w-plans list-none items-stretch gap-5 p-0 [grid-template-columns:repeat(auto-fit,minmax(300px,1fr))]"
  >
    {
      copy.plans.map((plan) => (
        <li
          class:list={[
            'relative flex flex-col rounded-panel bg-card p-9',
            plan.highlighted ? 'border border-highlight' : 'border border-hairline',
          ]}
        >
          {plan.highlighted && (
            <span class="absolute -top-[13px] left-9 rounded-pill bg-accent-deep px-3.5 py-1.5 text-[12px] font-semibold uppercase tracking-[0.05em] text-white">
              {copy.popularBadge}
            </span>
          )}

          <h2 class="m-0 text-[20px] font-semibold text-white">{plan.name}</h2>

          <p class="m-0 mt-[18px] flex items-baseline gap-2">
            <span class="text-price font-semibold text-white">{plan.price}</span>
            {plan.showPeriod && (
              <span class="text-caption text-secondary">{copy.perUser}</span>
            )}
          </p>

          <p class="m-0 mt-2 text-caption text-secondary">{plan.note}</p>

          <Button
            href={signupHref(`pricing_${plan.id}`)}
            variant={plan.highlighted ? 'primary' : 'secondary'}
            class="mt-7 justify-center px-6 py-3.5 text-[15px]"
          >
            {plan.cta}
          </Button>

          <dl class="m-0 mt-7 flex flex-col gap-3 border-t border-hairline pt-6">
            {plan.limits.map((limit) => (
              <div class="flex justify-between gap-3 text-caption">
                <dt class="text-secondary">{limit.label}</dt>
                <dd class="m-0 font-medium text-primary">{limit.value}</dd>
              </div>
            ))}
          </dl>

          {plan.inherits && (
            <p class="m-0 mt-6 text-[13px] font-semibold text-secondary">
              {plan.inherits}
            </p>
          )}

          <ul
            class:list={[
              'flex list-none flex-col gap-3 p-0',
              plan.inherits ? 'mt-3' : 'mt-6',
            ]}
          >
            {plan.features.map((feature) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 flex-none text-accent">
                  <Icon name="check" size={16} strokeWidth={2} />
                </span>
                <span class="text-[15px] leading-[1.5] text-primary">{feature}</span>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</section>
