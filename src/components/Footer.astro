---
import { t, defaultLocale, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const copy = t(locale).footer;
---

<footer class="border-t border-hairline bg-page px-6 py-12">
  <div
    class="mx-auto flex max-w-site flex-wrap items-center justify-between gap-8"
  >
    <img
      src="/assets/logo-full-dark.svg"
      width="122"
      height="24"
      alt={copy.logoAlt}
      class="block h-6 w-auto"
    />

    <div class="flex flex-wrap items-center gap-10">
      {
        copy.links.map((link) => (
          <a
            href={link.href}
            class="text-[15px] font-medium text-primary transition-colors duration-fast ease-brand hover:text-accent-light"
          >
            {link.label}
          </a>
        ))
      }

      <div class="flex items-center gap-3.5">
        <a
          href={copy.linkedin.href}
          aria-label={copy.linkedin.label}
          class="flex h-10 w-10 items-center justify-center rounded-input border border-hairline bg-card transition-colors duration-fast ease-brand hover:bg-elevated"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="text-primary" aria-hidden="true">
            <path
              d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.5 8h4V23h-4V8zm7.5 0h3.8v2.05h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V23h-4v-7.9c0-1.88-.03-4.3-2.62-4.3-2.63 0-3.03 2.05-3.03 4.17V23H8V8z"
            ></path>
          </svg>
        </a>

        <span class="text-[13px] leading-[1.5] text-tertiary">
          {copy.copyright}<br />{copy.rights}
        </span>
      </div>
    </div>
  </div>
</footer>
