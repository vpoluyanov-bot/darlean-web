---
import Icon from './Icon.astro';
import { t, defaultLocale, type Locale } from '../i18n';
import { SECTION_VH } from '../lib/ai-timeline.js';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const copy = t(locale).ai;

/* On a wide screen this section pins its contents and lets scroll position
   play the sequence; its height is the sum of the steps in
   src/lib/ai-timeline.js, which the script reads too, so pacing and height
   cannot drift apart.

   Below md there is no pinning and no sequence. A phone screen cannot hold a
   staged reveal without hiding most of it, and hijacking a touch scroll to
   play an animation is worse than simply showing the content — so the same
   material is laid out as a plain vertical story. */

const agentTheme = {
  task: {
    card: 'bg-agent-task-card',
    name: 'text-agent-task-name',
    pill: 'bg-agent-task-wash',
    bar: 'bg-agent-task',
  },
  report: {
    card: 'bg-light',
    name: 'text-agent-report-name',
    pill: 'bg-agent-report-wash',
    bar: 'bg-agent-report',
  },
  expense: {
    card: 'bg-light',
    name: 'text-agent-expense-name',
    pill: 'bg-agent-expense-wash',
    bar: 'bg-agent-expense',
  },
  secretary: {
    card: 'bg-light',
    name: 'text-agent-secretary-name',
    pill: 'bg-agent-secretary-wash',
    bar: 'bg-agent-secretary',
  },
} as const;
---

<section
  class="bg-light md:h-[var(--ai-section-height)]"
  style={`--ai-section-height:${SECTION_VH}vh`}
  data-ai-section
  aria-label="The AI assistant"
>
  <div
    class="px-6 py-24 md:sticky md:top-0 md:box-border md:h-screen md:overflow-hidden md:py-0"
  >
    <!--
      The sphere. It ships as a ten-second video rather than the Lottie file it
      was drawn as: the Lottie is 300 base64 PNG frames, 3.1 MB gzipped, for a
      160px decoration. Hidden on phones, where it would sit behind the text
      with nowhere to breathe.
    -->
    <div
      data-ai-sphere
      class="pointer-events-none absolute left-1/2 top-1/2 hidden aspect-square w-[clamp(260px,34vw,440px)] -translate-x-1/2 -translate-y-1/2 md:block"
    >
      <video
        data-lazy-video
        data-poster="/media/ai-sphere-poster.webp"
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
        class="h-full w-full object-contain"
      >
        <source data-src="/media/ai-sphere.webm" type="video/webm" />
        <source data-src="/media/ai-sphere.mp4" type="video/mp4" />
      </video>
    </div>

    <div
      data-ai-intro
      class="flex flex-col items-center gap-7 md:absolute md:inset-0 md:justify-center md:px-6"
    >
      <h2
        data-ai-reveal
        class="m-0 max-w-[18em] text-balance text-center text-[clamp(32px,3.5vw,52px)] font-semibold leading-[1.08] tracking-[-0.03em] text-on-light md:opacity-0 md:[transform:translateY(28px)]"
      >
        {copy.title}
      </h2>

      <p
        data-ai-reveal
        class="m-0 max-w-[34em] text-balance text-center font-rounded text-[clamp(17px,1.4vw,21px)] leading-[1.55] text-on-light-secondary md:opacity-0 md:[transform:translateY(28px)]"
      >
        {copy.lead}
      </p>

      <ul
        class="mt-6 grid w-full max-w-[1080px] list-none grid-cols-1 gap-5 p-0 sm:grid-cols-3"
      >
        {
          copy.cards.map((card) => (
            <li
              data-ai-reveal
              class="rounded-card bg-light-card p-7 md:opacity-0 md:[transform:translateY(48px)]"
            >
              <span class="flex h-9 w-9 items-center justify-center rounded-tile bg-wash text-accent-deep">
                <Icon name={card.icon} size={18} />
              </span>
              <p class="m-0 mt-4 text-balance text-[16px] font-medium leading-[1.5] text-on-light-body">
                {card.text}
              </p>
            </li>
          ))
        }
      </ul>
    </div>

    <h2
      data-ai-agents-title
      class="pointer-events-none m-0 mt-24 text-balance text-center text-[clamp(30px,8vw,40px)] font-semibold leading-[1.08] tracking-[-0.03em] text-on-light md:absolute md:inset-0 md:mt-0 md:flex md:items-center md:justify-center md:px-6 md:text-[clamp(36px,4.6vw,68px)] md:opacity-0"
    >
      {copy.agentsTitle}
    </h2>

    <div class="md:pointer-events-none md:absolute md:inset-0">
      <!-- The chips are only ever the shrink target of a card, so a phone,
           which never plays that step, has no use for them. -->
      <ul
        class="absolute left-0 right-0 top-[13vh] hidden list-none flex-wrap justify-center gap-4 p-0 px-6 md:flex"
      >
        {
          copy.agents.map((agent, i) => (
            <li
              data-agent-chip={i}
              class:list={[
                'flex w-[150px] flex-col items-center gap-3 rounded-card px-4 pb-4 pt-5 opacity-0',
                agentTheme[agent.id].card,
              ]}
            >
              <picture>
                <source srcset={`/media/${agent.still}.webp`} type="image/webp" />
                <img
                  src={`/media/${agent.still}.png`}
                  alt={agent.portraitAlt}
                  width="83"
                  height="82"
                  loading="lazy"
                  decoding="async"
                  class="h-[82px] w-[83px] object-contain"
                />
              </picture>
              <span
                class:list={[
                  'text-balance text-center text-caption font-semibold leading-tight',
                  agentTheme[agent.id].name,
                ]}
              >
                {agent.name}
              </span>
            </li>
          ))
        }
      </ul>

      <div
        class="mt-10 flex flex-col gap-6 md:absolute md:left-1/2 md:top-1/2 md:mt-0 md:block md:h-[min(66vh,580px)] md:w-[min(1120px,94%)] md:-translate-x-1/2 md:-translate-y-1/2"
      >
        {
          copy.agents.map((agent, i) => (
            <article
              data-agent-card={i}
              class="agent-card grid grid-cols-1 overflow-hidden rounded-panel bg-light md:absolute md:inset-0 md:box-border md:items-center md:gap-[clamp(20px,2vw,32px)] md:opacity-0 md:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)]"
            >
              <div class="relative flex aspect-square items-center justify-center md:aspect-auto md:h-full">
                <video
                  data-agent-video
                  data-lazy-video
                  data-poster={`/media/${agent.still}.webp`}
                  muted
                  loop
                  playsinline
                  preload="none"
                  aria-label={agent.name}
                  class="absolute inset-4 h-[calc(100%-32px)] w-[calc(100%-32px)] object-contain"
                >
                  <source data-src={`/media/${agent.video}.webm`} type="video/webm" />
                  <source data-src={`/media/${agent.video}.mp4`} type="video/mp4" />
                </video>
              </div>

              <div class="flex flex-col justify-center px-6 pb-8 md:px-0 md:py-[clamp(24px,3vw,48px)] md:pr-[clamp(24px,3vw,48px)] md:pb-[clamp(24px,3vw,48px)]">
                <h3
                  class:list={[
                    'm-0 text-balance text-[clamp(24px,2.4vw,34px)] font-semibold leading-[1.12] tracking-[-0.02em]',
                    agentTheme[agent.id].name,
                  ]}
                >
                  {agent.name}
                </h3>

                <p class="m-0 mt-3 text-balance text-[clamp(15px,1.3vw,17px)] leading-[1.5] text-on-light-body">
                  {agent.quote}
                </p>

                <div class="mb-3 mt-6 text-[16px] font-semibold text-on-light">
                  {copy.jobTitle}
                </div>

                <ul class="flex list-none flex-col gap-3 p-0">
                  {agent.instructions.map((line) => (
                    <li
                      class:list={[
                        'flex items-center gap-3 rounded-pill px-5 py-3',
                        agentTheme[agent.id].pill,
                      ]}
                    >
                      <span
                        class:list={[
                          'h-3.5 w-[3px] flex-none rounded-[2px]',
                          agentTheme[agent.id].bar,
                        ]}
                      />
                      <span class="text-caption leading-tight text-on-light-body">
                        {line}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* The one place the design system's "no shadows" rule is relaxed for a
     surface: the agent cards float above the white canvas. */
  @keyframes shadowFloat {
    0%,
    100% {
      box-shadow:
        0 30px 90px -20px rgba(84, 94, 190, 0.35),
        0 10px 30px -10px rgba(84, 94, 190, 0.16);
    }
    50% {
      box-shadow:
        0 46px 140px -14px rgba(84, 94, 190, 0.48),
        0 18px 56px -8px rgba(84, 94, 190, 0.24);
    }
  }

  .agent-card {
    animation: shadowFloat 5s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .agent-card {
      animation: none;
    }
  }
</style>
