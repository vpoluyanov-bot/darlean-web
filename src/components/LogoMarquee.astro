---
import { t, defaultLocale, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const { logos } = t(locale).customers;

/* Two identical halves, each carrying its own trailing gap, so translating the
   track by exactly half its width lands the second half where the first began.
   A single flex row with a shared `gap` cannot do this: the duplicated strip
   ends up half a gap short and the loop visibly jumps. */
const halves = [0, 1];

const tracking: Record<string, string> = {
  tight: 'tracking-[-0.02em]',
  normal: 'tracking-[0.03em]',
  wide: 'tracking-[0.12em]',
};
---

<section class="pb-16" aria-label="Customers">
  <div
    class="mx-auto max-w-site overflow-hidden [mask-image:linear-gradient(90deg,transparent,#000_12%,#000_88%,transparent)]"
  >
    <div class="marquee flex w-max">
      {
        halves.map((half) => (
          <ul
            class="flex w-max list-none items-center gap-20 p-0 pr-20"
            aria-hidden={half === 1 ? 'true' : undefined}
          >
            {logos.map((logo) => (
              <li
                class:list={[
                  'whitespace-nowrap text-h3 font-semibold text-tertiary',
                  tracking[logo.style],
                ]}
              >
                {logo.name}
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>

<style>
  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .marquee {
    /* One half is 1941px wide; 39s holds the ~49px/s the strip ran at before
       the names changed. Change the names and this needs recalculating, or the
       strip speeds up and slows down with the copy. */
    animation: marquee 39s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee {
      animation: none;
    }
  }
</style>
