---
import { t, defaultLocale, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const { logos } = t(locale).customers;

// The strip is duplicated so the marquee can loop on a -50% translate.
const strip = [...logos, ...logos];

const tracking: Record<string, string> = {
  tight: 'tracking-[-0.02em]',
  normal: 'tracking-[0.03em]',
  wide: 'tracking-[0.12em]',
};
---

<section class="pb-16" aria-label="Customers">
  <div
    class="mx-auto max-w-site overflow-hidden [mask-image:linear-gradient(90deg,transparent,#000_12%,#000_88%,transparent)]"
  >
    <div class="marquee flex w-max items-center gap-20">
      {
        strip.map((logo) => (
          <span
            class:list={[
              'whitespace-nowrap text-h3 font-semibold text-tertiary',
              tracking[logo.style],
            ]}
          >
            {logo.name}
          </span>
        ))
      }
    </div>
  </div>
</section>

<style>
  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .marquee {
    animation: marquee 32s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee {
      animation: none;
    }
  }
</style>
