---
import Icon from './Icon.astro';
import { t, defaultLocale, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const copy = t(locale).security;

// Heights of the decorative activity bars, in percent. Purely visual.
const bars = [30, 55, 22, 75, 48, 66, 34, 58, 42, 80];
---

<section class="bg-page px-6 pb-40 pt-30" aria-label="Security">
  <div class="mx-auto max-w-site">
    <h2
      class="m-0 max-w-[20em] text-balance text-[clamp(32px,3.5vw,52px)] font-semibold leading-[1.1] tracking-[-0.03em] text-white"
    >
      {copy.title}
    </h2>

    <p
      class="mt-5 max-w-[38em] text-balance font-rounded text-[clamp(17px,1.4vw,21px)] leading-[1.55] text-secondary"
    >
      {copy.lead}
    </p>

    <div
      class="mt-16 grid gap-5 [grid-template-columns:repeat(auto-fit,minmax(320px,1fr))]"
    >
      <article
        class="flex flex-col rounded-panel border border-hairline bg-card p-9"
      >
        <span
          class="flex h-11 w-11 items-center justify-center rounded-input bg-wash-strong text-accent"
        >
          <Icon name={copy.signIn.icon} />
        </span>
        <h3
          class="m-0 mt-6 text-[24px] font-semibold leading-[1.2] tracking-[-0.02em] text-white"
        >
          {copy.signIn.title}
        </h3>
        <p class="mt-3.5 text-balance text-[16px] leading-[1.55] text-secondary">
          {copy.signIn.text}
        </p>

        <ul class="mt-7 flex list-none flex-col gap-2.5 p-0">
          {
            copy.signIn.rows.map((row) => (
              <li class="flex items-center justify-between gap-3 rounded-input border border-hairline bg-elevated px-4 py-3.5">
                <span class="flex items-center gap-2.5 text-caption font-medium text-primary">
                  <span class="h-2 w-2 rounded-full bg-accent" />
                  {row.label}
                </span>
                <span class="rounded-pill bg-wash-pill px-2.5 py-1.5 text-[11px] font-semibold uppercase tracking-[0.06em] text-accent-light">
                  {row.badge}
                </span>
              </li>
            ))
          }
          <li
            class="flex items-center gap-2.5 rounded-input border border-hairline px-4 py-3.5 text-caption text-tertiary"
          >
            <span class="h-2 w-2 rounded-full bg-inactive"></span>
            {copy.signIn.revoked}
          </li>
        </ul>
      </article>

      <div class="flex flex-col gap-5">
        {
          [copy.roles, copy.signing].map((card) => (
            <article class="flex-1 rounded-panel border border-hairline bg-card p-9">
              <span class="flex h-11 w-11 items-center justify-center rounded-input bg-wash-strong text-accent">
                <Icon name={card.icon} />
              </span>
              <h3 class="m-0 mt-6 text-[24px] font-semibold leading-[1.2] tracking-[-0.02em] text-white">
                {card.title}
              </h3>
              <p class="mt-3.5 text-balance text-[16px] leading-[1.55] text-secondary">
                {card.text}
              </p>
            </article>
          ))
        }
      </div>

      <article
        class="flex flex-col rounded-panel border border-hairline bg-card p-9"
      >
        <span
          class="flex h-11 w-11 items-center justify-center rounded-input bg-wash-strong text-accent"
        >
          <Icon name={copy.noLeaks.icon} />
        </span>
        <h3
          class="m-0 mt-6 text-[24px] font-semibold leading-[1.2] tracking-[-0.02em] text-white"
        >
          {copy.noLeaks.title}
        </h3>
        <p class="mt-3.5 text-balance text-[16px] leading-[1.55] text-secondary">
          {copy.noLeaks.text}
        </p>

        <div
          class="mt-auto flex h-14 items-end gap-2 pt-7"
          aria-hidden="true"
        >
          {
            bars.map((h) => (
              <span
                class="flex-1 rounded-t-[6px] bg-bar"
                style={`height:${h}%`}
              />
            ))
          }
        </div>

        <div
          class="mt-4 flex items-center justify-between gap-3 rounded-input border border-hairline bg-elevated px-4 py-3.5"
        >
          <span
            class="flex items-center gap-2.5 text-caption font-medium text-primary"
          >
            <span class="h-2 w-2 rounded-full bg-accent"></span>
            {copy.noLeaks.row.label}
          </span>
          <span
            class="rounded-pill bg-wash-pill px-2.5 py-1.5 text-[11px] font-semibold uppercase tracking-[0.06em] text-accent-light"
          >
            {copy.noLeaks.row.badge}
          </span>
        </div>
      </article>
    </div>

    <div
      class="mt-5 grid gap-5 [grid-template-columns:repeat(auto-fit,minmax(320px,1fr))]"
    >
      <article class="rounded-panel border border-hairline bg-card p-9">
        <span
          class="flex h-11 w-11 items-center justify-center rounded-input bg-wash-strong text-accent"
        >
          <Icon name={copy.export.icon} />
        </span>
        <h3
          class="m-0 mt-6 text-[24px] font-semibold leading-[1.2] tracking-[-0.02em] text-white"
        >
          {copy.export.title}
        </h3>
        <p class="mt-3.5 text-balance text-[16px] leading-[1.55] text-secondary">
          {copy.export.text}
        </p>
      </article>

      <article
        class="grid items-center gap-8 rounded-panel border border-hairline bg-card p-9 [grid-template-columns:repeat(auto-fit,minmax(260px,1fr))]"
      >
        <div>
          <span
            class="flex h-11 w-11 items-center justify-center rounded-input bg-wash-strong text-accent"
          >
            <Icon name={copy.audit.icon} />
          </span>
          <h3
            class="m-0 mt-6 text-[24px] font-semibold leading-[1.2] tracking-[-0.02em] text-white"
          >
            {copy.audit.title}
          </h3>
          <p
            class="mt-3.5 text-balance text-[16px] leading-[1.55] text-secondary"
          >
            {copy.audit.text}
          </p>
        </div>

        <ol class="m-0 flex list-none flex-col p-0">
          {
            copy.audit.steps.map((step, i, all) => {
              const last = i === all.length - 1;
              return (
                <li class="flex gap-3.5">
                  <span class="flex flex-col items-center" aria-hidden="true">
                    <span
                      class:list={[
                        'mt-1.5 h-2.5 w-2.5 flex-none rounded-full border-2 border-accent',
                        last && 'bg-accent',
                      ]}
                    />
                    {!last && <span class="w-px flex-1 bg-chip" />}
                  </span>
                  <span class:list={[!last && 'pb-[22px]']}>
                    <span class="block text-[15px] font-semibold text-primary">
                      {step.label}
                    </span>
                    <span class="mt-0.5 block text-[13px] text-tertiary">
                      {step.meta}
                    </span>
                  </span>
                </li>
              );
            })
          }
        </ol>
      </article>
    </div>
  </div>
</section>
