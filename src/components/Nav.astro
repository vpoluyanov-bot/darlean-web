---
import Button from './Button.astro';
import { t, defaultLocale, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const copy = t(locale).nav;
---

<nav
  class="sticky top-0 z-50 border-b border-nav bg-glass backdrop-blur-glass backdrop-saturate-[1.8]"
>
  <div
    class="mx-auto flex h-nav max-w-site items-center justify-between gap-8 px-6"
  >
    <a href="/" class="flex items-center">
      <img
        src="/assets/logo-full-dark.svg"
        width="102"
        height="20"
        alt={copy.logoAlt}
        class="block"
      />
    </a>

    <Button href="#start" variant="secondary" class="px-5 py-2 text-caption">
      {copy.cta}
    </Button>
  </div>
</nav>
