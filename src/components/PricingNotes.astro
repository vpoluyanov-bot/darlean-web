---
import { contactHref } from '../config';
import { t, defaultLocale, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const notes = t(locale).pricing.notes;
---

<section class="px-6 pb-30" aria-label="Good to know">
  <ul
    class="mx-auto grid max-w-plans list-none gap-5 p-0 [grid-template-columns:repeat(auto-fit,minmax(280px,1fr))]"
  >
    {
      notes.map((note) => (
        <li class="rounded-card border border-hairline bg-card p-7">
          <h2 class="m-0 text-[16px] font-semibold text-white">{note.title}</h2>

          <p class="m-0 mt-2.5 text-balance text-caption leading-[1.55] text-secondary">
            {/* Kept on one line: a line break here would render as a space
                between the link and the full stop that follows it. */}
            {note.text ?? (
              <Fragment>{note.textBefore}<a href={contactHref(note.emailSubject)} class="text-accent transition-colors duration-fast ease-brand hover:text-accent-light">{note.linkLabel}</a>{note.textAfter}</Fragment>
            )}
          </p>
        </li>
      ))
    }
  </ul>
</section>
