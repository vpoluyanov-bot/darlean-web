---
import Button from './Button.astro';
import { signupHref } from '../config';
import { t, defaultLocale, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const copy = t(locale).hero;
---

<section
  class="flex min-h-[calc(100vh-220px)] items-center px-6 pb-20 pt-8"
  aria-label="Darlean"
>
  <div
    class="mx-auto grid w-full max-w-site grid-cols-1 items-center gap-16 md:[grid-template-columns:repeat(auto-fit,minmax(360px,1fr))]"
  >
    <div>
      <h1
        class="hero-in text-balance text-[clamp(32px,3.9vw,48px)] font-semibold leading-[1.06] tracking-[-0.03em] text-white"
      >
        {copy.titleLine1}
        <span class="block bg-headline bg-clip-text text-transparent">
          {copy.titleLine2}
        </span>
      </h1>

      <p
        class="hero-in mt-6 max-w-[32em] text-balance font-rounded text-body leading-[1.55] text-secondary"
        style="animation-delay:120ms"
      >
        {copy.lead}
      </p>

      <ul
        class="hero-in mt-8 flex list-none flex-wrap gap-3 p-0"
        style="animation-delay:200ms"
      >
        {
          copy.chips.map((chip) => (
            <li class="rounded-pill border border-chip bg-card px-3 py-2 text-[12px] font-medium leading-none text-secondary">
              {chip}
            </li>
          ))
        }
      </ul>

      <div class="hero-in mt-11" style="animation-delay:280ms">
        <Button href={signupHref('home_hero')} class="px-7 py-4">{copy.cta}</Button>

        <p
          class="mt-4 flex items-center gap-3 whitespace-nowrap text-caption text-tertiary"
        >
          {copy.noteBefore}
          <span class="text-[11px] text-accent" aria-hidden="true">✦</span>
          {copy.noteAfter}
        </p>
      </div>
    </div>

    <!--
      One clip, no device frames around it. The mockups are drawn inside the
      video and it sits on black, so the page background runs straight into it
      and only the corners need rounding.
    -->
    <div class="hero-in" style="animation-delay:200ms">
      <video
        data-hero-video
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        poster="/media/hero-agent-poster.webp"
        aria-label={copy.videoLabel}
        class="block w-full rounded-panel"
      >
        <source src="/media/hero-agent.webm" type="video/webm" />
        <source src="/media/hero-agent.mp4" type="video/mp4" />
      </video>
    </div>
  </div>
</section>
