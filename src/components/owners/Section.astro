---
import MockPlaceholder from './MockPlaceholder.astro';
import Reveal from './Reveal.astro';
import SectionBody from './SectionBody.astro';
import SectionCopy from './SectionCopy.astro';
import TimeStamp from './TimeStamp.astro';

/**
 * One chapter of the day, in one of four layouts.
 *
 * These follow the home page rather than inventing anything: `a` is its
 * two-column module, text one side and visual the other; `b` is its heading
 * block with the content underneath; `title` is the centred block it uses for
 * a closing statement. Whichever applies, a section has one alignment — the
 * first version mixed four in a single section, which is what this fixes.
 */
interface Mock {
  caption: string;
  alt: string;
  ratio: string;
  width: number;
  format: string;
}

interface Props {
  layout: 'a' | 'b' | 'title' | 'divider';
  eyebrow?: string;
  time?: string;
  period?: string;
  headline?: string;
  sub?: string;
  body: string;
  feature?: string;
  mock?: Mock;
}

const {
  layout,
  eyebrow,
  time,
  period,
  headline,
  sub,
  body,
  feature,
  mock,
} = Astro.props;

const padding =
  layout === 'title'
    ? 'py-section-sm md:py-section'
    : layout === 'divider'
      ? 'py-20 md:py-24'
      : 'py-24 md:py-30';
---

<section class:list={['px-6', padding]}>
  <div class="mx-auto max-w-site">
    {
      layout === 'title' && (
        <div class="text-center">
          <Reveal>
            <SectionCopy eyebrow={eyebrow} headline={headline} sub={sub} large />
          </Reveal>

          <Reveal delay={120} class="mt-8">
            <SectionBody body={body} feature={feature} centred />
          </Reveal>

          <Reveal delay={260} class="mt-10">
            <slot />
          </Reveal>
        </div>
      )
    }

    {
      layout === 'divider' && (
        <Reveal>
          <TimeStamp time={time!} period={period} />
          <div class="mt-8">
            <SectionBody body={body} />
          </div>
        </Reveal>
      )
    }

    {
      /* Type A — the home page's two-column module. The visual takes a column
         of its own instead of floating in the middle of the text, which is
         what left those empty margins beside a portrait phone.

         Text is always on the left. The home page alternates sides, but it has
         four modules broken up by coloured panels; six of these run back to
         back on black, where alternating reads as flicker rather than variety.
         Both were built and compared before settling on this. */
      layout === 'a' && (
        <div class="grid grid-cols-1 items-center gap-12 md:grid-cols-2 md:gap-16">
          <Reveal>
            <SectionCopy
              eyebrow={eyebrow}
              time={time}
              period={period}
              headline={headline}
              sub={sub}
            />
            <div class="mt-8">
              <SectionBody body={body} feature={feature} />
            </div>
          </Reveal>

          {mock && (
            <Reveal delay={120} class="flex justify-center">
              <MockPlaceholder {...mock} />
            </Reveal>
          )}
        </div>
      )
    }

    {
      /* Type B — heading block, then the content, the way Security and
         Onboarding are built. A landscape visual spans the column; a section
         with no visual is simply the same stack without one. */
      layout === 'b' && (
        <Fragment>
          <Reveal>
            <SectionCopy
              eyebrow={eyebrow}
              time={time}
              period={period}
              headline={headline}
              sub={sub}
            />
          </Reveal>

          {mock && (
            <Reveal delay={120} class="mt-16 flex justify-center">
              <MockPlaceholder {...mock} />
            </Reveal>
          )}

          <Reveal delay={mock ? 200 : 120} class="mt-16">
            <SectionBody body={body} feature={feature} />
          </Reveal>
        </Fragment>
      )
    }
  </div>
</section>
