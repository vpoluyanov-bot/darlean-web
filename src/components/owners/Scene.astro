---
import GhostHour from './GhostHour.astro';
import HeroBackdrop from './HeroBackdrop.astro';
import Heading from './Heading.astro';
import Reveal from './Reveal.astro';
import Stage from './Stage.astro';

/**
 * One scene of the day. The variant decides its silhouette, and the order they
 * appear in is chosen so no two neighbours are shaped alike — that alternation
 * is what gives the page its rhythm.
 *
 *   opening   full height, centred, the page's own title
 *   question  the hour set huge behind the line it belongs to
 *   split     copy in one column, a lit stage in the other
 *   stats     the same split, with numbers where the paragraph would be
 *   showcase  one object centred and large, copy tight above it
 *   wide      a landscape stage running past the text column
 *   divider   a compressed band, there to break the pace
 *   closing   the last statement and the way in
 */
interface Mock {
  caption: string;
  alt: string;
  ratio: string;
  width: number;
  format: string;
}

interface Stat {
  value: string;
  label: string;
}

interface Props {
  variant: 'opening' | 'question' | 'split' | 'stats' | 'showcase' | 'wide' | 'divider' | 'closing';
  /** Which side the stage takes in a split. */
  side?: 'start' | 'end';
  eyebrow?: string;
  time?: string;
  period?: string;
  headline?: string;
  headlineAccent?: string;
  sub?: string;
  body: string;
  feature?: string;
  mock?: Mock;
  stats?: Stat[];
  scrollCue?: string;
  /** Base name of a clip in public/media to run behind the scene. */
  backdrop?: string;
}

const {
  variant,
  side = 'end',
  eyebrow,
  time,
  period,
  headline,
  headlineAccent,
  sub,
  body,
  feature,
  mock,
  stats,
  scrollCue,
  backdrop,
} = Astro.props;

/* Vertical rhythm is part of the composition, not a constant. The scenes that
   carry a single large object get room around them; the splits sit closer
   together so the page moves; the divider is deliberately cramped. */
const padding = {
  opening: 'scene-opening pt-[clamp(1rem,6svh,7vh)] pb-[clamp(0.75rem,3svh,4rem)]',
  question: 'pb-16 md:pb-28',
  split: 'py-20 md:py-24',
  stats: 'py-20 md:py-24',
  showcase: 'py-24 md:py-40',
  wide: 'py-24 md:py-40',
  divider: 'py-12 md:py-16',
  closing: 'min-h-[80vh] py-section-sm md:py-section',
}[variant];

const isSplit = variant === 'split' || variant === 'stats';
const isCentred = variant === 'question' || variant === 'showcase';

/* The hour goes behind the copy it belongs to, so it follows that copy's
   alignment: centred scenes get it centred, a split gets it on whichever side
   the words are. */
const ghostAlign = isCentred ? 'center' : isSplit && side === 'start' ? 'end' : 'start';
const portrait = mock ? Number(mock.ratio.split('/')[0]) < Number(mock.ratio.split('/')[1]) : false;
---

<section
  class:list={['scene relative px-6', padding, variant === 'divider' && 'scene-divider']}
  data-first-screen={variant === 'opening' ? '' : undefined}
>
  {backdrop && <HeroBackdrop name={backdrop} />}

  {
    /* Ambient light behind the two title scenes, so the page opens and closes
       on something warmer than flat black. A scene with a backdrop needs none:
       the footage is the ambience, and a second glow over it would only eat
       into the contrast the scrim was sized to protect. */
    !backdrop && (variant === 'opening' || variant === 'closing') && (
      <div class="scene-aura" aria-hidden="true" />
    )
  }

  {
    /* Every scene that happens at an hour carries that hour behind it. */
    time && (
      <GhostHour
        hour={time}
        align={ghostAlign}
        anchor={variant === 'divider' ? 'middle' : 'top'}
      />
    )
  }

  <div
    class:list={[
      'relative z-10 mx-auto',
      variant === 'wide' ? 'max-w-bleed' : 'max-w-site',
      (variant === 'opening' || variant === 'closing') &&
        'flex flex-col items-center text-center',
      variant === 'opening' && 'w-full flex-1 justify-start',
      variant === 'closing' && 'min-h-[inherit] justify-center',
    ]}
  >
    {
      variant === 'opening' && (
        <Fragment>
          <Reveal>
            <Heading
              size="hero"
              eyebrow={eyebrow}
              headline={headline}
              headlineAccent={headlineAccent}
              centred
            />
          </Reveal>

          <Reveal delay={140} class="mt-[clamp(1.25rem,3svh,2.5rem)] max-w-[46em]">
            <p class="m-0 text-balance text-lead leading-[1.5] text-secondary">{body}</p>
          </Reveal>

          {scrollCue && (
            <Reveal delay={320} class="mt-[clamp(1.5rem,5svh,4rem)]">
              <span class="scroll-cue inline-flex flex-col items-center gap-3 text-[11px] uppercase tracking-[0.26em] text-secondary">
                {scrollCue}
                <span class="scroll-line" aria-hidden="true" />
              </span>
            </Reveal>
          )}
        </Fragment>
      )
    }

    {
      /* The question the whole product answers. Everything here is centred on
         one axis — the hour behind it, the line, the question, the paragraph
         and the label — so the scene reads as a single column rather than
         three alignments fighting. */
      variant === 'question' && (
        <div class="question-copy flex flex-col items-center text-center">
          <Reveal>
            <Heading headline={headline} centred />
          </Reveal>

          {sub && (
            <Reveal delay={120} class="mt-8">
              <p class="key-line m-0 text-balance">{sub}</p>
            </Reveal>
          )}

          <Reveal delay={220} class="mt-10 max-w-[38em]">
            <p class="m-0 text-balance text-body leading-[1.6] text-secondary">{body}</p>
          </Reveal>

          {period && (
            <Reveal delay={300} class="mt-10">
              <span class="inline-flex items-center gap-3 rounded-pill border border-hairline px-4 py-2 text-[11px] uppercase tracking-[0.26em] text-accent">
                {period}
              </span>
            </Reveal>
          )}
        </div>
      )
    }

    {
      isSplit && (
        <div class="grid grid-cols-1 items-center gap-14 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:gap-20">
          <Reveal class:list={[side === 'start' && 'md:order-2']}>
            <Heading
              size="panel"
              period={period}
              eyebrow={eyebrow}
              headline={headline}
              sub={sub}
            />

            {stats ? (
              <dl class="mt-10 grid grid-cols-3 gap-6">
                {stats.map((stat) => (
                  <div>
                    <dt class="sr-only">{stat.label}</dt>
                    <dd class="m-0">
                      <span class="block text-[clamp(32px,3.6vw,52px)] font-semibold leading-none tracking-[-0.03em] text-accent-light">
                        {stat.value}
                      </span>
                      <span class="mt-3 block text-caption leading-tight text-secondary">
                        {stat.label}
                      </span>
                    </dd>
                  </div>
                ))}
              </dl>
            ) : null}

            <p class="m-0 mt-8 max-w-[34em] text-balance text-body leading-[1.6] text-secondary">
              {body}
            </p>

            {feature && (
              <p class="m-0 mt-6">
                <span class="inline-flex items-center rounded-pill border border-hairline bg-card px-3.5 py-1.5 text-caption text-secondary">
                  {feature}
                </span>
              </p>
            )}
          </Reveal>

          {mock && (
            <Reveal
              move="settle"
              delay={120}
              class:list={['flex justify-center', side === 'start' && 'md:order-1']}
            >
              <Stage {...mock} device={portrait} />
            </Reveal>
          )}
        </div>
      )
    }

    {
      /* One object, centred and large, with the copy held tight above it so
         the two read as a single unit rather than two stacked blocks. */
      variant === 'showcase' && (
        <div class="flex flex-col items-center text-center">
          <Reveal>
            <Heading period={period} headline={headline} sub={sub} centred />
          </Reveal>

          {mock && (
            <Reveal move="settle" delay={140} class="mt-14 flex w-full justify-center">
              <Stage {...mock} device={portrait} />
            </Reveal>
          )}

          <Reveal delay={220} class="mt-14 max-w-[38em]">
            <p class="m-0 text-balance text-body leading-[1.6] text-secondary">{body}</p>
            {feature && (
              <p class="m-0 mt-6">
                <span class="inline-flex items-center rounded-pill border border-hairline bg-card px-3.5 py-1.5 text-caption text-secondary">
                  {feature}
                </span>
              </p>
            )}
          </Reveal>
        </div>
      )
    }

    {
      /* A landscape stage is allowed to run wider than the text that
         introduces it — the copy column stays readable, the picture does not. */
      variant === 'wide' && (
        <Fragment>
          <div class="mx-auto max-w-site">
            <Reveal>
              <Heading period={period} headline={headline} sub={sub} />
            </Reveal>
          </div>

          {mock && (
            <Reveal move="settle" delay={140} class="mt-14 flex justify-center md:mt-20">
              <Stage {...mock} />
            </Reveal>
          )}

          <div class="mx-auto mt-14 max-w-site md:mt-20">
            <Reveal delay={220}>
              <p class="m-0 max-w-[38em] text-balance text-body leading-[1.6] text-secondary">
                {body}
              </p>
              {feature && (
                <p class="m-0 mt-6">
                  <span class="inline-flex items-center rounded-pill border border-hairline bg-card px-3.5 py-1.5 text-caption text-secondary">
                    {feature}
                  </span>
                </p>
              )}
            </Reveal>
          </div>
        </Fragment>
      )
    }

    {
      variant === 'divider' && (
        <Reveal class="flex flex-col gap-6 md:flex-row md:items-baseline md:justify-between md:gap-16">
          <p class="m-0">
            <span class="text-[12px] font-semibold uppercase tracking-[0.26em] text-accent">
              {period}
            </span>
          </p>
          <p class="m-0 max-w-[34em] text-body leading-[1.6] text-tertiary">{body}</p>
        </Reveal>
      )
    }

    {
      variant === 'closing' && (
        <Fragment>
          <Reveal>
            <Heading
              size="hero"
              eyebrow={eyebrow}
              headline={headline}
              headlineAccent={headlineAccent}
              centred
            />
          </Reveal>

          <Reveal delay={140} class="mt-10 max-w-[42em]">
            <p class="m-0 text-balance text-lead leading-[1.5] text-secondary">{body}</p>
          </Reveal>

          <Reveal delay={280} class="mt-12">
            <slot />
          </Reveal>
        </Fragment>
      )
    }
  </div>
</section>

<style>
  /*
   * The opening is exactly the first screen and no more: the viewport less the
   * header standing above it, so the scene ends where the fold does and the
   * backdrop inside it is never cut off below. --first-screen is measured by
   * the page's script, because the header is two rows tall on a narrow phone
   * and one on everything else; until it has run, and if it never does, svh
   * alone is close enough and still fits.
   *
   * min-height rather than height: on a very short window the copy is allowed
   * to push the scene past one screen rather than be clipped by it.
   */
  .scene-opening {
    display: flex;
    flex-direction: column;
    min-height: var(--first-screen, 100svh);
  }

  /* A hairline above and below, so the beat reads as a band rather than a gap. */
  .scene-divider {
    border-block: 1px solid var(--border-hairline);
    background: color-mix(in srgb, var(--surface-card) 45%, transparent);
  }

  .scene-aura {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse 70% 55% at 50% 38%,
      color-mix(in srgb, var(--accent) 16%, transparent),
      transparent 70%
    );
  }

  /*
   * The copy starts a little past the middle of the hour behind it, so the top
   * half of the number stands clear and it reads as a background rather than
   * something with a lid on it. Everywhere else on the page the headline meets
   * its number at around half its height; this is that same relationship,
   * written out because this is the one scene where both are centred on the
   * same axis and would otherwise land on top of each other.
   *
   * 0.42 is 0.8 — the number's line box — times the 0.52 of it the other scenes
   * leave clear. The 26px is where the number itself starts: GhostHour's --edge
   * plus the room it reserves for the parallax.
   */
  .question-copy {
    padding-top: calc(26px + 0.42 * clamp(150px, 27vw, 400px));
  }

  /* Not a subheading — the question the rest of the page is answering. */
  .key-line {
    max-width: 16em;
    font-size: clamp(24px, 3.4vw, 40px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: transparent;
    background: var(--gradient-headline);
    background-clip: text;
    -webkit-background-clip: text;
  }

  .scroll-line {
    display: block;
    width: 1px;
    height: clamp(28px, 4svh, 56px);
    background: linear-gradient(180deg, var(--accent), transparent);
  }

  .scroll-cue {
    animation: cue-drift 2.6s var(--ease) infinite;
  }

  @keyframes cue-drift {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.75;
    }
    50% {
      transform: translateY(6px);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-cue {
      animation: none;
    }

  }
</style>
