---
/**
 * Brings an element in as it reaches the screen, once.
 *
 * Three movements, because different things should arrive differently: copy
 * rises, a stage settles in with a touch of scale, a number counts itself up
 * from below. All of them are transform and opacity only — nothing here asks
 * the browser to lay the page out again mid-scroll.
 *
 * With reduced motion the element is simply present from the start.
 */
interface Props {
  as?: 'div' | 'span' | 'li';
  move?: 'up' | 'settle' | 'rise';
  /** Milliseconds of stagger for the second, third, fourth thing in a scene. */
  delay?: number;
  class?: string;
}

const { as: Tag = 'div', move = 'up', delay = 0, class: className = '' } = Astro.props;
---

<Tag
  data-reveal
  data-move={move}
  class:list={['reveal', className]}
  style={delay ? `--reveal-delay:${delay}ms` : undefined}
>
  <slot />
</Tag>

<style is:global>
  .reveal {
    opacity: 0;
    transition:
      opacity var(--duration-slow) var(--ease) var(--reveal-delay, 0ms),
      transform var(--duration-slow) var(--ease) var(--reveal-delay, 0ms);
  }

  .reveal[data-move='up'] {
    transform: translate3d(0, 22px, 0);
  }

  .reveal[data-move='settle'] {
    transform: translate3d(0, 34px, 0) scale(0.965);
  }

  .reveal[data-move='rise'] {
    transform: translate3d(0, 48px, 0);
  }

  .reveal[data-shown] {
    opacity: 1;
    transform: none;
  }

  /* No script, or motion turned down: everything is simply visible. */
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
