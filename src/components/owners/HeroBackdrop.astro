---
/**
 * The moving backdrop of the opening scene.
 *
 * It is decoration, not content: silent, looping, without controls, and hidden
 * from assistive technology. The words on top are the message; this is the room
 * they are spoken in.
 *
 * Nothing is fetched for it while the page is still loading. The poster frame —
 * 3.6 KB of WebP — is all that arrives at first paint; the real URLs sit in
 * `data-src` until the page's own load event has fired, and the script in
 * for-business-owners.astro moves them across then. If the reader asked for
 * less motion, they are never moved at all and the poster is the backdrop.
 *
 * Over it sits a scrim built from --surface-page, which is what keeps the copy
 * legible: the footage peaks at a luminance that would drop the lead paragraph
 * to 2.1:1 unaided. See the note on .hero-scrim below for the arithmetic.
 */
interface Props {
  /** Base name of the clip in public/media. */
  name: string;
}

const { name } = Astro.props;

const poster = `/media/${name}-poster.webp`;
const webm = `/media/${name}.webm`;
const mp4 = `/media/${name}.mp4`;
---

<div class="hero-backdrop" aria-hidden="true">
  <video
    data-hero-backdrop
    muted
    loop
    playsinline
    preload="none"
    poster={poster}
    tabindex="-1"
    class="h-full w-full object-cover"
  >
    <source data-src={webm} type="video/webm" />
    <source data-src={mp4} type="video/mp4" />
  </video>

  <div class="hero-scrim"></div>
</div>

<style>
  .hero-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /*
   * 65% of the page colour over the footage.
   *
   * Measured, not guessed: the brightest pixel in the clip is rgb(39,83,134),
   * over which --text-secondary (#86868B, the lead paragraph) would sit at
   * 2.13:1. Compositing black at 65% leaves rgb(14,29,47) at that point, which
   * takes the lead back to 4.69:1 and the white headline to 15.9:1 — both past
   * WCAG AA, at every frame and every viewport width.
   *
   * The two edge fades are composition rather than contrast: the top one gives
   * the sticky header something calm to sit on, the bottom one lets the scene
   * dissolve into the black page instead of ending on a visible seam.
   */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        var(--surface-page),
        color-mix(in srgb, var(--surface-page) 0%, transparent) 22%,
        color-mix(in srgb, var(--surface-page) 0%, transparent) 82%,
        var(--surface-page)
      ),
      color-mix(in srgb, var(--surface-page) 65%, transparent);
  }
</style>
