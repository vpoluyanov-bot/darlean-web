---
/**
 * The hour, set enormous and sunk behind the scene it belongs to.
 *
 * This is the page's one recurring device: every moment of the day announces
 * itself as a number behind the words rather than as a caption above them. It
 * sits behind the copy it belongs to — left of a scene whose text is left,
 * centred where the scene is centred — so it reads as that scene's marker and
 * not as decoration floating loose on the page.
 *
 * It is clipped to the section, which is what lets a short band show a slice of
 * a very large number instead of overflowing the page.
 */
interface Props {
  hour: string;
  /** Follows the alignment of the copy it sits behind. */
  align?: 'start' | 'center' | 'end';
  /** A compressed band gets a smaller number so a legible part of it shows. */
  size?: 'lg' | 'sm';
  /** Vertical anchor: scenes that lead with a heading want it near the top. */
  anchor?: 'top' | 'middle';
}

const { hour, align = 'start', size = 'lg', anchor = 'top' } = Astro.props;

const justify = {
  start: 'justify-start',
  center: 'justify-center',
  end: 'justify-end',
}[align];

const items = anchor === 'top' ? 'items-start' : 'items-center';
---

<div class:list={['ghost-clip', justify, items]} aria-hidden="true">
  <span class:list={['ghost-hour', size === 'sm' && 'ghost-hour--sm']} data-parallax>
    {hour}
  </span>
</div>

<style>
  .ghost-clip {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: flex;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
  }

  .ghost-hour {
    /* Pulled up so the number is cut by the top of the section rather than
       sitting politely inside it. On a narrow screen it is barely pulled at
       all: the number is small there, and cropping it hard would leave only a
       faint middle band where the bright top of the glyph should be. */
    margin-top: -0.08em;
    margin-inline: -0.05em;
    font-size: clamp(150px, 27vw, 400px);
    font-weight: 600;
    line-height: 0.8;
    letter-spacing: -0.06em;
    white-space: nowrap;
    color: transparent;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--text-primary) 15%, transparent),
      transparent 76%
    );
    background-clip: text;
    -webkit-background-clip: text;
    will-change: transform;
  }

  @media (min-width: 768px) {
    .ghost-hour {
      margin-top: -0.22em;
    }
  }

  .ghost-hour--sm {
    margin-top: -0.3em;
    font-size: clamp(96px, 13vw, 190px);
  }

  @media (prefers-reduced-motion: reduce) {
    .ghost-hour {
      will-change: auto;
    }
  }
</style>
