---
/**
 * The explanatory paragraph and the feature it names.
 *
 * Separated from the heading stack so that a section's body can sit under a
 * heading in one layout and beside a visual in another without either copy of
 * it drifting out of step.
 */
interface Props {
  body: string;
  feature?: string;
  centred?: boolean;
}

const { body, feature, centred = false } = Astro.props;
---

<div class:list={[centred && 'mx-auto']}>
  <p
    class:list={[
      'm-0 max-w-[38em] text-balance text-body leading-[1.55] text-secondary',
      centred && 'mx-auto',
    ]}
  >
    {body}
  </p>

  {
    feature && (
      <p class="m-0 mt-4 text-caption text-tertiary">{feature}</p>
    )
  }
</div>
