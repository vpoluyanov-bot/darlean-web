---
import '../styles/global.css';
import { t, defaultLocale, type Locale } from '../i18n';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
}

const { title, description, locale = defaultLocale } = Astro.props;
const copy = t(locale);
---

<html lang={copy.site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description ?? copy.site.description} />

    <!-- Latin covers the visible copy on first paint; cyrillic loads on demand. -->
    <link
      rel="preload"
      href="/fonts/inter-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>

  <body class="bg-page text-primary font-sans antialiased">
    <slot />

    <script>
      import '../scripts/attribution.js';
    </script>
  </body>
</html>
