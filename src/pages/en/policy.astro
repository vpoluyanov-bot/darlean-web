---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import RegionalLegal from '../../components/RegionalLegal.astro';
import Footer from '../../components/Footer.astro';
import { t, defaultLocale } from '../../i18n';

const copy = t(defaultLocale).legalRegional.policy;
---

<BaseLayout title={copy.title} description={copy.description}>
  <Nav />
  <main class="px-6 pb-30 pt-20">
    <RegionalLegal doc="policy" />
  </main>
  <Footer />
</BaseLayout>
