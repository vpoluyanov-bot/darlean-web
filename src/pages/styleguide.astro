---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { readTokens, tokenMap, contrast, aa } from '../lib/tokens';
import { t, defaultLocale } from '../i18n';

/* Internal reference page. Its labels stay inline on purpose — this is a
   developer tool, not a page that ships in English and Russian. */

const meta = t(defaultLocale).site;

const colors = readTokens('colors.css');
const type = tokenMap('typography.css');
const spacing = readTokens('spacing.css');
const radii = readTokens('radii.css');
const motion = readTokens('motion.css');
const site = readTokens('site.css');

// Split the project extensions so colours can be shown as swatches.
const siteSwatches = site.filter((t) => /^#|^rgba/.test(t.value));
const siteValues = site.filter((t) => !/^#|^rgba/.test(t.value));

const surfaces = ['--surface-page', '--surface-card', '--surface-elevated'] as const;
const colorMap = tokenMap('colors.css');

const swatches = colors.filter((t) => /^#|^rgba/.test(t.value));

const foregrounds = [
  '--text-display',
  '--text-primary',
  '--text-secondary',
  '--text-tertiary',
  '--accent-light',
  '--accent',
  '--accent-deep',
];

const typeScale = [
  { token: 'display', label: 'Display', cls: 'text-display' },
  { token: 'h1', label: 'Heading 1', cls: 'text-h1' },
  { token: 'h2', label: 'Heading 2', cls: 'text-h2' },
  { token: 'h3', label: 'Heading 3', cls: 'text-h3' },
  { token: 'lead', label: 'Lead', cls: 'text-lead' },
  { token: 'body', label: 'Body', cls: 'text-body' },
  { token: 'caption', label: 'Caption', cls: 'text-caption' },
];

const weights = [
  { label: 'Regular 400', cls: 'font-regular' },
  { label: 'Medium 500', cls: 'font-medium' },
  { label: 'Semibold 600', cls: 'font-semibold' },
];

const spaceSteps = spacing.filter((t) => t.name.startsWith('--space-'));
const widths = spacing.filter((t) => !t.name.startsWith('--space-'));

const radiusClass: Record<string, string> = {
  '--radius-small': 'rounded-small',
  '--radius-input': 'rounded-input',
  '--radius-card': 'rounded-card',
  '--radius-panel': 'rounded-panel',
  '--radius-pill': 'rounded-pill',
};
---

<BaseLayout title={meta.styleguideTitle} description={meta.styleguideDescription} noindex>
  <main class="mx-auto max-w-content px-6 py-24">
    <header class="mb-24">
      <h1 class="text-h1 font-semibold text-white">Styleguide</h1>
      <p class="mt-4 max-w-measure text-lead text-secondary">
        Every value on this page is read from <code class="text-primary">src/styles/tokens/</code>
        at build time. Change a token and this page changes with it.
      </p>
    </header>

    <!-- Colour ------------------------------------------------------- -->
    <section class="mb-24">
      <h2 class="text-h2 font-semibold text-white">Colour</h2>

      <div class="mt-10 grid grid-cols-1 gap-4 min-[420px]:grid-cols-2 sm:grid-cols-3">
        {swatches.map((token) => (
          <div class="overflow-hidden rounded-card border border-hairline">
            <div class="h-20" style={`background:${token.value}`}></div>
            <div class="bg-card px-4 py-3">
              <div class="break-all text-caption text-primary">{token.name}</div>
              <div class="break-all text-caption text-tertiary">{token.value}</div>
            </div>
          </div>
        ))}
      </div>

      <h3 class="mt-16 text-h3 font-semibold text-white">Contrast against surfaces</h3>
      <p class="mt-3 max-w-measure text-body text-secondary">
        WCAG AA needs 4.5:1 for body text and 3:1 for text at 24px and above.
      </p>

      <div class="mt-8 overflow-x-auto">
        <table class="w-full border-collapse text-caption">
          <thead>
            <tr class="border-b border-hairline text-left text-tertiary">
              <th class="py-3 pr-4 font-medium">Text token</th>
              {surfaces.map((s) => (
                <th class="py-3 pr-4 font-medium">{s.replace('--surface-', '')}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {foregrounds.map((fg) => (
              <tr class="border-b border-hairline">
                <td class="py-3 pr-4" style={`color:${colorMap[fg]}`}>{fg}</td>
                {surfaces.map((bg) => {
                  const ratio = contrast(colorMap[fg], colorMap[bg]);
                  if (ratio === null) return <td class="py-3 pr-4 text-tertiary">—</td>;

                  const pass = aa(ratio);
                  return (
                    <td class="py-3 pr-4">
                      <span class="text-primary">{ratio.toFixed(2)}:1</span>
                      <span
                        class:list={[
                          'ml-2',
                          pass.normal ? 'text-accent-light' : pass.large ? 'text-secondary' : 'text-tertiary',
                        ]}
                      >
                        {pass.normal ? 'AA' : pass.large ? 'AA large only' : 'fails'}
                      </span>
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Type --------------------------------------------------------- -->
    <section class="mb-24">
      <h2 class="text-h2 font-semibold text-white">Type</h2>
      <p class="mt-3 max-w-measure text-body text-secondary">
        Inter, self-hosted, latin and cyrillic, weights 400 to 600.
      </p>

      <div class="mt-10 space-y-8">
        {typeScale.map((step) => (
          <div class="border-b border-hairline pb-8">
            <div class="text-caption text-tertiary">
              {step.label} · {type[`--text-${step.token}-size`]} / {type[`--text-${step.token}-lh`]}
              {type[`--text-${step.token}-track`] ? ` · ${type[`--text-${step.token}-track`]}` : ''}
            </div>
            <p class:list={[step.cls, 'mt-3 font-semibold text-white']}>
              HR that runs itself
            </p>
          </div>
        ))}
      </div>

      <div class="mt-12 space-y-3">
        {weights.map((w) => (
          <p class:list={[w.cls, 'text-h3 text-white']}>{w.label} — Сергей Ivanov 2026</p>
        ))}
      </div>

      <div class="mt-12">
        <div class="text-caption text-tertiary">Gradient headline (--gradient-headline)</div>
        <p class="mt-3 bg-headline bg-clip-text text-h1 font-semibold text-transparent">
          Darvis handles the rest.
        </p>
      </div>
    </section>

    <!-- Spacing ------------------------------------------------------ -->
    <section class="mb-24">
      <h2 class="text-h2 font-semibold text-white">Spacing</h2>

      <div class="mt-10 space-y-3">
        {spaceSteps.map((token) => (
          <div class="flex items-center gap-6">
            <div class="w-32 shrink-0 text-caption text-tertiary">{token.name}</div>
            <div class="w-16 shrink-0 text-caption text-secondary">{token.value}</div>
            <div class="h-3 rounded-small bg-accent" style={`width:${token.value}`}></div>
          </div>
        ))}
      </div>

      <div class="mt-12 space-y-2">
        {widths.map((token) => (
          <div class="flex gap-6 text-caption">
            <span class="w-56 text-tertiary">{token.name}</span>
            <span class="text-primary">{token.value}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Radii -------------------------------------------------------- -->
    <section class="mb-24">
      <h2 class="text-h2 font-semibold text-white">Radii</h2>

      <div class="mt-10 flex flex-wrap gap-6">
        {radii.map((token) => (
          <div class="text-center">
            <div
              class:list={[
                'h-28 w-28 border border-control bg-card',
                radiusClass[token.name],
              ]}
            ></div>
            <div class="mt-3 text-caption text-primary">{token.name.replace('--radius-', '')}</div>
            <div class="text-caption text-tertiary">{token.value}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- Surfaces ----------------------------------------------------- -->
    <section class="mb-24">
      <h2 class="text-h2 font-semibold text-white">Surfaces and borders</h2>

      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        <div class="rounded-card border border-hairline bg-card p-6">
          <div class="text-body text-primary">Card</div>
          <div class="mt-2 text-caption text-secondary">surface-card + hairline</div>
        </div>
        <div class="rounded-card border border-hairline bg-elevated p-6">
          <div class="text-body text-primary">Elevated</div>
          <div class="mt-2 text-caption text-secondary">hover state, one step up</div>
        </div>
        <div class="rounded-card border border-control bg-card p-6">
          <div class="text-body text-primary">Control border</div>
          <div class="mt-2 text-caption text-secondary">buttons and inputs</div>
        </div>
      </div>
    </section>

    <!-- Motion ------------------------------------------------------- -->
    <section class="mb-24">
      <h2 class="text-h2 font-semibold text-white">Motion</h2>

      <div class="mt-10 space-y-2">
        {motion.map((token) => (
          <div class="flex gap-6 text-caption">
            <span class="w-40 text-tertiary">{token.name}</span>
            <span class="text-primary">{token.value}</span>
          </div>
        ))}
      </div>
      <p class="mt-6 max-w-measure text-caption text-secondary">
        Durations drop to zero when the visitor asks for reduced motion.
      </p>
    </section>

    <!-- Project extensions ------------------------------------------- -->
    <section class="mb-24">
      <h2 class="text-h2 font-semibold text-white">Project extensions</h2>
      <p class="mt-3 max-w-measure text-body text-secondary">
        Values the homepage comp needs that the design system does not define.
        They live in <code class="text-primary">tokens/site.css</code>, apart from
        the design system, so they stay easy to review and promote upstream.
      </p>

      <div class="mt-10 grid grid-cols-1 gap-4 min-[420px]:grid-cols-2 sm:grid-cols-3">
        {siteSwatches.map((token) => (
          <div class="overflow-hidden rounded-card border border-hairline">
            <div class="h-20" style={`background:${token.value}`}></div>
            <div class="bg-card px-4 py-3">
              <div class="break-all text-caption text-primary">{token.name}</div>
              <div class="break-all text-caption text-tertiary">{token.value}</div>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-10 space-y-2">
        {siteValues.map((token) => (
          <div class="flex gap-6 text-caption">
            <span class="w-56 shrink-0 text-tertiary">{token.name}</span>
            <span class="truncate text-primary">{token.value}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Buttons ------------------------------------------------------ -->
    <section class="mb-24">
      <h2 class="text-h2 font-semibold text-white">Buttons</h2>

      <div class="mt-10 flex flex-wrap items-center gap-6">
        <Button href="#">See a demo</Button>
        <Button href="#" variant="secondary">Talk to sales</Button>
      </div>
    </section>
  </main>
</BaseLayout>
