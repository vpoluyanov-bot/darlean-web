---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Scene from '../components/owners/Scene.astro';
import { signupHref } from '../config';
import { t, defaultLocale } from '../i18n';

/* The presentation this came from carries no navigation of its own, so the
   site's own header and footer are put around it — unchanged, the same
   components every other page uses. The page is deliberately absent from the
   header's links: the way in is still the "For business owners" card on the
   home page, and the header is there to let a visitor leave. */

const copy = t(defaultLocale).owners;
---

<BaseLayout title={copy.title} description={copy.description}>
  <Nav />
  <main class="overflow-x-clip">
    <h1 class="sr-only">{copy.title}</h1>

    {
      copy.sections.map((section, i) => (
        <Scene
          {...section}
          scrollCue={i === 0 ? copy.scrollCue : undefined}
          backdrop={i === 0 ? 'owners-hero' : undefined}
        >
          {section.variant === 'closing' && (
            <Button href={signupHref('role_owner')} class="px-9 py-4 text-lead font-semibold">
              {copy.cta}
            </Button>
          )}
        </Scene>
      ))
    }
  </main>
  <Footer />
</BaseLayout>

<script>
  /**
   * Two jobs, both cheap.
   *
   * Reveals are handed to an IntersectionObserver and unobserved once they
   * fire — nothing keeps watching after the fact. The parallax on the giant
   * hour runs off one scroll listener shared by every such element, throttled
   * to a frame, and writes nothing but a transform.
   *
   * If the reader asked for less motion, neither runs: everything is shown at
   * once and left where it is.
   */
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const reveals = document.querySelectorAll<HTMLElement>('[data-reveal]');

  /**
   * The opening's backdrop clip is the last thing the page asks for. Its
   * <source> elements ship with no src at all, so nothing is queued while the
   * document, the fonts and the first screen are still arriving; only once the
   * load event has fired — and then only in an idle moment — are the URLs put
   * in place and the clip told to play. Under reduced motion it is never
   * fetched, and the poster frame stays as the backdrop.
   */
  /**
   * The opening scene is the first screen exactly: whatever is left of the
   * viewport once the header above it has taken its share. The header is one
   * row on most windows and two on a narrow phone, so its height is measured
   * rather than assumed, and measured again whenever the window changes.
   */
  const firstScreen = document.querySelector<HTMLElement>('[data-first-screen]');
  const header = document.querySelector('nav');

  if (firstScreen && header) {
    const fit = () => {
      const left = window.innerHeight - header.getBoundingClientRect().height;
      firstScreen.style.setProperty('--first-screen', `${Math.round(left)}px`);
    };

    fit();
    window.addEventListener('resize', fit, { passive: true });
    window.addEventListener('orientationchange', fit);
  }

  const backdrop = document.querySelector<HTMLVideoElement>('[data-hero-backdrop]');

  if (backdrop && !reduced) {
    const start = () => {
      for (const source of backdrop.querySelectorAll<HTMLSourceElement>('source[data-src]')) {
        source.src = source.dataset.src!;
        source.removeAttribute('data-src');
      }
      backdrop.load();
      // load() cancels a play() issued in the same tick, so wait for frames.
      backdrop.addEventListener('loadeddata', () => {
        backdrop.muted = true;
        backdrop.play().catch(() => {});
      });
    };

    const idle = () =>
      'requestIdleCallback' in window
        ? requestIdleCallback(start, { timeout: 2000 })
        : setTimeout(start, 200);

    if (document.readyState === 'complete') idle();
    else window.addEventListener('load', idle, { once: true });
  }

  if (reduced) {
    reveals.forEach((el) => el.setAttribute('data-shown', ''));
  } else {
    const watcher = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.setAttribute('data-shown', '');
          watcher.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -10% 0px' }
    );

    reveals.forEach((el) => watcher.observe(el));

    const drifting = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];

    if (drifting.length) {
      let queued = false;

      /* Each element says how far it may travel, in --drift, and its own
         layout has that much room reserved at each end — so the drift can
         never carry it out of the scene it belongs to. */
      const travel = new Map(
        drifting.map((el) => [el, parseFloat(getComputedStyle(el).getPropertyValue('--drift')) || 0])
      );

      const drift = () => {
        queued = false;
        const middle = window.innerHeight / 2;

        for (const el of drifting) {
          const box = el.getBoundingClientRect();
          // Only while it is anywhere near the screen.
          if (box.bottom < -200 || box.top > window.innerHeight + 200) continue;
          const limit = travel.get(el)!;
          const raw = (box.top + box.height / 2 - middle) * -0.08;
          const offset = Math.max(-limit, Math.min(limit, raw));
          el.style.transform = `translate3d(0, ${offset.toFixed(1)}px, 0)`;
        }
      };

      const onScroll = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(drift);
      };

      drift();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
    }
  }
</script>
